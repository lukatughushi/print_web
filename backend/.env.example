# ---- Server ----
NODE_ENV=development
# Render injects PORT automatically in production.
PORT=3000

# ---- Database (MongoDB Atlas) ----
# Atlas → Connect → Drivers. In Atlas "Network Access", allow 0.0.0.0/0 for Render.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/printweb?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Optional: also allow Vercel preview deployments, e.g. https://your-app-git-branch-team.vercel.app
# Set to the project slug prefix; leave empty to disable.
VERCEL_PREVIEW_PROJECT=your-app

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
